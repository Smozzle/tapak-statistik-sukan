rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user whose UID has a document in /admins.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public can read rumah sukan, races, athletes and records; only admins can change them.
    match /rumahSukan/{rumahId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /perlumbaan/{perlumbaanId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /peserta/{pesertaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rekod/{rekodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Old results format. No longer used by the site, so it is closed to the public.
    // Admins can still read it for the one-time "Tukar keputusan lama" button, but nothing can change it.
    // Delete this block (and the collection) once the conversion is done.
    match /keputusan/{keputusanId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The first admin is added by hand in the Firebase console. After that, admins approve
    // requests from the "Pentadbir" page.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Someone who signed up asks for admin access. Only they can create their own request.
    match /permohonanAdmin/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nama', 'email', 'dibuat'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 1
        && request.resource.data.nama.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.dibuat == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
